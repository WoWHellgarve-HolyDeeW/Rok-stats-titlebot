POSTGRES_USER=rok
POSTGRES_PASSWORD=rok
POSTGRES_DB=rokstats
DATABASE_URL=postgresql+psycopg2://rok:rok@db:5432/rokstats
INGEST_TOKEN=
REDIS_URL=redis://redis:6379/0
USE_ASYNC_INGEST=0

# Security Settings
# IMPORTANTE: Mude estas chaves antes de expor o serviço fora do ambiente local.
AUTH_SECRET_KEY=change-me-with-a-long-random-string

# CORS Origins (comma-separated URLs)
# Exemplo: https://yoursite.com,https://api.yoursite.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 only in development to allow all origins
CORS_ALLOW_ALL=0

# Internal API key for server-side operations (import scans, etc.)
INTERNAL_API_KEY=change-me-internal-api-key

# Bot API key for bot endpoints (title bot, scanner bot)
# If not set, falls back to INTERNAL_API_KEY
BOT_API_KEY=

# Optional one-time admin bootstrap.
# Set both values for the first backend start, then remove them.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
